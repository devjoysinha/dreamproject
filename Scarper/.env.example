# Production database. Never commit the real value.
DATABASE_URL=postgresql://postgres:password@database-host:5432/app

# Required. Supports ordinary proxy URLs and host:port:user:password format.
PROXY=socks5://proxy.example.com:1080:username:password

# Required for Telegram scrape summaries.
TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_CHAT_ID=-1000000000000
TELEGRAM_NOTIFY_EVERY_RUN=true

# The scraper fetches root-feed records through the configured proxy.
LEAKSHAVEN_ROOT_COUNT=30
MAX_RESOLVES_PER_RUN=30
REQUEST_TIMEOUT_SECONDS=45
REDIRECT_TIMEOUT_SECONDS=120

# Bound the number of high-memory direct-link pages.  Lower concurrency helps
# avoid source validation bursts and prevents browser OOM crashes on EC2.
DIRECT_LINK_BATCH_SIZE=3
DIRECT_LINK_NAVIGATION_TIMEOUT_SECONDS=15
DIRECT_LINK_SETTLE_TIMEOUT_SECONDS=45
# Deferred source-validation pages get up to this many regular, proxy-backed
# sessions before they are removed. They are never exposed publicly.
MAX_DIRECT_LINK_ATTEMPTS=4

# New preview images are copied to this bucket before being stored in Postgres.
# On EC2, grant the instance role s3:GetObject and s3:PutObject for this prefix.
ASSET_BUCKET=dreamproject-profile-images
ASSET_REGION=us-east-1
ASSET_PREFIX=root-feed
ASSET_PUBLIC_BASE_URL=https://dzromswftdto7.cloudfront.net
MAX_IMAGE_BYTES=12582912
