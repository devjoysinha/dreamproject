[Unit]
Description=Leakporns root-feed scraper
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ec2-user
Group=ec2-user
WorkingDirectory=/opt/dreamproject/Scarper
EnvironmentFile=/opt/dreamproject/Scarper/.env
RuntimeDirectory=dream-scraper
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/flock -n /run/dream-scraper/scraper.lock /opt/dreamproject/Scarper/.venv/bin/python /opt/dreamproject/Scarper/leakshaven_root_scraper.py
# Bounded direct-link batches trade a little throughput for a stable browser
# process.  The overall job still has room to finish a full feed window.
TimeoutStartSec=20min
Nice=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
