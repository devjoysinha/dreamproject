# PostgreSQL connection used by the application and importer.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Optional: Redis is reserved for response caching and background jobs.
REDIS_URL=redis://localhost:6379
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
# Absolute path to the supplied model JSON directory.
MODEL_DATA_DIR=/Users/you/Desktop/Project/model_json
# Private S3 origin and its public CloudFront delivery URL for imported images.
ASSET_REGION=us-east-1
ASSET_BUCKET=dreamproject-profile-images
ASSET_PUBLIC_BASE_URL=https://dzromswftdto7.cloudfront.net
# Google OAuth is configured in Google Auth Platform. Keep these values server-only.
GOOGLE_CLIENT_ID=your-google-web-client-id
GOOGLE_CLIENT_SECRET=your-google-web-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# At least 32 random characters. For example: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-secret
# Enable this with the public site key in Frontend/.env to protect each Open Link
# action with a verified Cloudflare Turnstile session. Browse pages remain public.
HUMAN_VERIFICATION_ENABLED=false
# Generate each with: openssl rand -base64 48
HUMAN_VERIFICATION_SECRET=
HUMAN_VERIFICATION_COOKIE_NAME=lp_human
HUMAN_VERIFICATION_TTL_SECONDS=43200
# A signed redirect ticket expires quickly after an Open Link is approved.
LINK_ACCESS_TTL_SECONDS=120
# Cap CAPTCHA (self-hosted). The API endpoint includes the site key path.
CAP_API_ENDPOINT=https://cap.leakporns.com/SITE_KEY/
# Server-only secret key from the Cap dashboard. Do not expose it to the browser.
CAP_SECRET_KEY=
# NOWPayments crypto payment gateway. Generate API key and IPN secret at nowpayments.io.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Price per credit top-up in USD (₹19 ≈ $0.22).
NOWPAYMENTS_PRICE_USD=0.22
# Local-only alternative: an ignored Google JSON file in Backend/. Leave unset in production.
# GOOGLE_OAUTH_CREDENTIALS_FILE=/absolute/path/to/client_secret_....json
