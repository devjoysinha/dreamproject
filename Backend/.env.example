# PostgreSQL connection used by the application and importer.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Optional: Redis is reserved for response caching and background jobs.
REDIS_URL=redis://localhost:6379
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
# Absolute path to the supplied model JSON directory.
MODEL_DATA_DIR=/Users/you/Desktop/Project/model_json
# Private S3 origin and its public CloudFront delivery URL for imported images.
ASSET_REGION=us-east-1
ASSET_BUCKET=dreamproject-profile-images
ASSET_PUBLIC_BASE_URL=https://dzromswftdto7.cloudfront.net
