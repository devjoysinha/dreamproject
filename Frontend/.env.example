# Next.js proxies these paths to the API in development. In production nginx
# proxies /api directly, so no public backend URL is required in the browser.
BACKEND_ORIGIN=http://localhost:4000
NEXT_PUBLIC_SITE_URL=https://leakporns.com
# Cloudflare Web Analytics site token from Web Analytics > Manage site.
CLOUDFLARE_WEB_ANALYTICS_TOKEN=
# Cap CAPTCHA endpoint (instance URL + site key). The backend keeps the secret
# server-only; this public endpoint is safe to expose to the browser.
NEXT_PUBLIC_CAP_API_ENDPOINT=https://cap.leakporns.com/SITE_KEY/
